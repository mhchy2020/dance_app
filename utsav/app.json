{
  "expo": {
    "name": "utsav",
    "slug": "utsav",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/utsav_icon.jpg",
    "scheme": "utsav",
    "userInterfaceStyle": "automatic",
    "ios": {},
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.mmchy.utsav"
    },
    "web": {
      "output": "static"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "src/assets/utsav_icon.jpg",
          "imageWidth": 76
        }
      ],
      "expo-image",
      "@react-native-vector-icons/ionicons",
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
